{
    "name": "rcc/sneakers-api",
    "description": "API RCC Sneakers — PHP natif, aucune dépendance en production",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rcc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rcc\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
