# Routage du site, à déposer dans public_html/ avec le contenu de dist/.
#
# Le site est une application d'une seule page : le serveur ne connaît que
# index.html, et c'est le navigateur qui décide quoi afficher selon l'adresse.
# Sans ce fichier, Apache cherche un dossier « boutique » qui n'existe pas et
# renvoie son propre 404 — pas la page 404 du site, la page grise d'Apache.
#
# Ce n'est pas un cas rare : c'est ce qui arrive au premier lien partagé sur
# WhatsApp, au premier favori, et à chaque fois que quelqu'un recharge la page
# sur laquelle il se trouve.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # L'API a son propre .htaccess dans son dossier ; on ne se met pas en
    # travers, sans quoi chaque appel reviendrait chercher index.html.
    RewriteRule ^api/ - [L]

    # Un fichier ou un dossier qui existe vraiment est servi tel quel : les
    # scripts, les styles, les visuels et les polices ne doivent pas être
    # remplacés par la page d'accueil.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# ------------------------------------------------------------------- caches
#
# Les fichiers de `assets/` portent une empreinte dans leur nom : leur contenu
# ne change jamais sans que le nom change. Ils peuvent donc être gardés un an.
#
# index.html, lui, ne doit **jamais** être mis en cache : c'est lui qui désigne
# la version des fichiers à charger. Mis en cache, il continuerait de réclamer
# les fichiers d'hier après une mise en ligne — et le site resterait figé sur la
# version précédente pour tous ceux qui l'ont déjà visité.

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------- politique de sécurité du contenu
#
# Elle dit au navigateur d'où il a le droit de charger quoi. Son intérêt est de
# limiter les dégâts d'une faille qu'on n'a pas vue : même si un texte hostile
# se retrouvait un jour dans la page, aucun script venu d'ailleurs ne pourrait
# s'exécuter, et rien ne pourrait être envoyé vers un autre domaine.
#
# `style-src` accepte l'inline parce que les dégradés de chaque fiche sont posés
# en attribut `style` — ils sont calculés à partir de la couleur de l'article, et
# ne peuvent donc pas vivre dans une feuille écrite d'avance. `script-src` ne
# l'accepte pas : tout le JavaScript est compilé dans un fichier.
#
# `connect-src 'self'` suffit parce que l'API partage le domaine. Si elle était
# un jour hébergée ailleurs, c'est cette ligne qu'il faudrait ouvrir — et rien
# d'autre.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"

    <FilesMatch "\.(css|js|webp|png|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Le listing d'un dossier ne révèle rien d'utile et beaucoup d'inutile.
Options -Indexes
